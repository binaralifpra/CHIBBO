rules_version = '2';

// Firestore Security Rules untuk CHIBBO
// Pasang di: Firebase Console > Firestore Database > Rules > tempel isi file ini > Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function masuk() {
      return request.auth != null;
    }

    function emailSaya() {
      return request.auth.token.email.lower();
    }

    // Admin = email yang terdaftar di koleksi "admins" (id dokumen = email huruf kecil)
    function isAdmin() {
      return masuk()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(emailSaya()));
    }

    // ===== Akun admin =====
    match /admins/{email} {
      allow read: if masuk() && (isAdmin() || emailSaya() == email);
      allow write: if isAdmin();
    }

    // ===== Data publik (dibaca website user, diubah admin) =====
    match /kategori/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /outlets/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pengaturan/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /menu/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      // Admin bebas mengubah. Pelanggan yang login hanya boleh MENGURANGI stok (saat checkout).
      allow update: if isAdmin() || (
        masuk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stok'])
        && request.resource.data.stok is int
        && request.resource.data.stok >= 0
        && request.resource.data.stok < resource.data.stok
      );
    }

    // ===== Profil pelanggan =====
    match /users/{uid} {
      allow read: if isAdmin() || (masuk() && request.auth.uid == uid);
      allow create, update: if masuk() && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // ===== Pesanan =====
    match /orders/{id} {
      allow read: if isAdmin() || (masuk() && resource.data.userId == request.auth.uid);
      allow create: if masuk()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'menunggu'
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update, delete: if isAdmin();
    }
  }
}
