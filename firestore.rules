rules_version = '2';

// Firestore Security Rules untuk CHIBBO
// Pasang di: Firebase Console > Firestore Database > Rules > tempel isi file ini > Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function masuk() {
      return request.auth != null;
    }

    function emailSaya() {
      return request.auth.token.email.lower();
    }

    // Admin = email yang terdaftar di koleksi "admins" (id dokumen = email huruf kecil)
    function isAdmin() {
      return masuk()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/admins/$(emailSaya()));
    }

    // Admin demo (dokumen admins berisi demo: true): boleh memproses pesanan, mengatur stok dan
    // tampil/sembunyi menu, serta buka/tutup outlet. Tidak boleh menambah, menghapus, atau
    // mengubah data lain (nama, harga, gambar, kategori, pengaturan, admin, pelanggan).
    function isDemo() {
      return isAdmin() && get(/databases/$(database)/documents/admins/$(emailSaya())).data.get('demo', false) == true;
    }

    // Admin penuh = admin yang bukan akun demo
    function isEditor() {
      return isAdmin() && !isDemo();
    }

    // ===== Akun admin =====
    match /admins/{email} {
      allow read: if masuk() && (isAdmin() || emailSaya() == email);
      allow write: if isEditor();
    }

    // ===== Data publik (dibaca website user, diubah admin) =====
    match /kategori/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /outlets/{id} {
      allow read: if true;
      allow create, delete: if isEditor();
      allow update: if isEditor() || (
        isDemo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['buka'])
        && request.resource.data.buka is bool
      );
    }

    match /pengaturan/{id} {
      allow read: if true;
      allow write: if isEditor();
    }

    match /menu/{id} {
      allow read: if true;
      allow create, delete: if isEditor();
      // Admin penuh bebas mengubah. Admin demo hanya boleh mengatur stok dan tampil/sembunyi menu.
      // Pelanggan yang login hanya boleh MENGURANGI stok (saat checkout).
      allow update: if isEditor() || (
        isDemo()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stok', 'aktif', 'updatedAt'])
        && request.resource.data.get('stok', 0) is int
        && request.resource.data.get('stok', 0) >= 0
      ) || (
        masuk()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stok'])
        && request.resource.data.stok is int
        && request.resource.data.stok >= 0
        && request.resource.data.stok < resource.data.stok
      );
    }

    // ===== Profil pelanggan =====
    match /users/{uid} {
      allow read: if isAdmin() || (masuk() && request.auth.uid == uid);
      allow create, update: if masuk() && request.auth.uid == uid;
      allow delete: if isEditor();
    }

    // ===== Pesanan =====
    match /orders/{id} {
      allow read: if isAdmin() || (masuk() && resource.data.userId == request.auth.uid);
      allow create: if masuk()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'menunggu'
        && request.resource.data.total is number
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      // Admin demo hanya boleh mengubah status pesanan (dan catatan yang menyertainya)
      allow update: if isEditor() || (
        isDemo()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'riwayat', 'updatedAt', 'alasanBatal', 'statusPembayaran'])
      );
      allow delete: if isEditor();
    }
  }
}
